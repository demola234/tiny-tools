          "items": {
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              },
              "severity": {
                "description": "error or warning",
                "type": "string"
              }
            },
            "required": [
              "severity",
              "file",
              "message"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "warnings": {
          "type": "integer"
        }
      },
      "required": [
        "errors",
        "warnings",
        "problems"
      ],
      "type": "object"
    }
  },
